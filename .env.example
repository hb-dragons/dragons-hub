# Database
DATABASE_URL=postgresql://dragons:dragons@localhost:5432/dragons

# API server
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug                   # fatal, error, warn, info, debug, trace (default: info)
RUN_MODE=both                     # api, worker, both (default: both)
VERBOSE_ERRORS=false              # true returns error detail in API responses; keep false in production

# Retention sweeps (days)
SYNC_RUN_RETENTION_DAYS=90
DOMAIN_EVENT_RETENTION_DAYS=365

# Authentication (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-48-chars-recommended
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000  # comma-separated; CORS + better-auth trusted origins

# Basketball-Bund SDK credentials
SDK_USERNAME=your-basketball-bund-username
SDK_PASSWORD=your-basketball-bund-password

# Google Cloud Storage (required for social features)
GCS_BUCKET_NAME=dragons-489109-social-assets
GCS_PROJECT_ID=dragons-489109

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001
# Scoreboard live page (public)
NEXT_PUBLIC_SCOREBOARD_DEVICE_ID=<panel name from Panel2Net.id>

# Email notifications (SMTP) — drives the `email` channel adapter
# (apps/api/src/services/notifications/channels/email.ts) over nodemailer.
# All five or none: a partial set reads as "not configured", the provider
# endpoint stops offering the channel and nothing is sent.
# Production: SMTP_HOST/PORT/USER/FROM are GitHub repo variables ->
# TF_VAR_smtp_* -> Cloud Run env_vars (API + Worker); SMTP_PASSWORD is a GitHub
# Actions secret -> Secret Manager (smtp-password-production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@dragons.de
# SMTP_PASSWORD=your-password
# SMTP_FROM=Dragons <noreply@dragons.de>

# Club inbox for public Probetraining submissions (POST /public/probetraining).
# Optional: when unset (or when SMTP is not configured) submissions are still
# stored and only the notification mail is skipped.
# PROBETRAINING_NOTIFY_TO=vorstand@dragons.de

# WAHA (WhatsApp HTTP API - for group notifications)
# Production: GitHub repo variables WAHA_BASE_URL / WAHA_SESSION ->
# TF_VAR_waha_base_url / TF_VAR_waha_session -> Cloud Run env_vars (API + Worker).
# Leave WAHA_BASE_URL empty to disable WhatsApp delivery; a non-URL value is
# rejected at boot.
WAHA_BASE_URL=http://localhost:3002
WAHA_SESSION=default

# Referee SDK (separate federation account, optional)
# REFEREE_SDK_USERNAME=
# REFEREE_SDK_PASSWORD=

# Expo Push (optional — enables authenticated send tier with higher rate limits)
# Get token from https://expo.dev → account settings → access tokens
# Production: GitHub Actions secret EXPO_ACCESS_TOKEN -> TF_VAR_expo_access_token
# -> Secret Manager (expo-access-token-production) -> API + Worker. Unset leaves
# push on the unauthenticated tier.
EXPO_ACCESS_TOKEN=
# Optional — EAS project id. Validated as a non-empty string at boot; nothing reads it yet.
EXPO_PROJECT_ID=

# Logging / observability (GCP-aware)
SERVICE_NAME=api                  # Log label; also useful for Cloud Run service name
# SERVICE_VERSION=                # Falls back to K_REVISION (auto-set by Cloud Run) or "unknown"
# GCP_PROJECT_ID=                 # Required for Cloud Logging → Cloud Trace correlation

# Scoreboard ingest (Raspberry Pi -> API)
SCOREBOARD_INGEST_KEY=<openssl rand -base64 48>
SCOREBOARD_DEVICE_ID=<panel name from Panel2Net.id>

# AI assistant (game rescheduling copilot)
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=gemini-2.5-flash
NEXT_PUBLIC_ASSISTANT_ENABLED=false # web: show the reschedule copilot entry point; must match ASSISTANT_ENABLED
GOOGLE_GENERATIVE_AI_API_KEY=<google ai studio key; required when ASSISTANT_ENABLED=true>
MCP_TOKEN=<random string min 32 chars; bearer token for the /mcp endpoint>

# Club Q&A assistant (members-only chatbot)
CHATBOT_ENABLED=false             # set true to enable the members-only club Q&A assistant
CHATBOT_MODEL=gemini-2.5-flash    # AI SDK model id for the club Q&A assistant
NEXT_PUBLIC_CHATBOT_ENABLED=false # web: mount the club assistant widget on public pages
EXPO_PUBLIC_CHATBOT_ENABLED=false # native: show the club assistant entry point
