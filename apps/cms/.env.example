# Payload CMS (apps/cms) — copy to apps/cms/.env
# These vars are read only by @dragons/cms; the root .env.example stays scoped
# to apps/api (docs-drift.test.ts enforces that).

# Second database on the shared dev postgres container. A fresh pgdata volume
# creates it via docker/postgres-init/; an existing volume needs it once by hand:
#   docker compose -f docker/docker-compose.dev.yml exec postgres createdb -U dragons dragons_cms
DATABASE_URL_CMS=postgresql://dragons:dragons@localhost:5432/dragons_cms

# openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Prod only: GCS bucket for the media collection (provisioned by OpenTofu,
# Task A5). Leave unset in dev — media then lands on local disk (apps/cms/media/).
# GCS_MEDIA_BUCKET=

# Prod only: "true" when the media bucket grants allUsers read (tofu var
# cms_media_public). Media URLs then point straight at storage.googleapis.com;
# anything else keeps them relative and proxied through this service. Must match
# the bucket's actual IAM or every image 403s.
# GCS_MEDIA_PUBLIC=

# Prod only: comma-separated public origins (first = Payload serverURL; all are
# trusted for CORS/CSRF — the load-balancer domains). Set by OpenTofu on the
# Cloud Run service. Leave unset in dev — Payload then uses relative URLs and
# same-origin requests.
# CMS_PUBLIC_URL=

# Prod only: fine-grained PAT (Task D3) for the repository_dispatch that
# rebuilds the public site on publish. Leave unset in dev — every dispatch is
# then a silent no-op. Same-named var on the API is the webhook channel's PAT.
# GH_DISPATCH_TOKEN=

# ---------------------------------------------------------------------------
# One-off Strapi import (issue #165) — read by `pnpm --filter @dragons/cms
# migrate:strapi` and by nothing else in this app. Leave all four unset unless
# you are running that migration; the script throws by name when one is missing.
# ---------------------------------------------------------------------------

# Legacy Strapi origin + a read token. A LAN address on purpose: the migration
# runs against the home server directly and must not depend on public DNS.
# STRAPI_URL=http://192.168.1.x:1337
# STRAPI_TOKEN=

# Target Payload REST origin + the token of an API-key user with write access.
# Same names as the apps/site pair, and in practice the same values — but the
# opposite direction: the site reads content at build time, this writes it once.
# Point CMS_URL at the environment being loaded (http://localhost:3002 in dev).
# CMS_URL=http://localhost:3002
# CMS_API_TOKEN=

# ---------------------------------------------------------------------------
# One-off CMS -> Hub staff import (issues #311, #329) — read by `pnpm --filter
# @dragons/cms migrate:cms-staff` and by nothing else in this app. Reuses the
# CMS_URL + CMS_API_TOKEN pair above (read direction this time) and needs the
# Hub's database on top; the script throws by name when one is missing.
# ---------------------------------------------------------------------------

# The Hub's connection string — NOT DATABASE_URL_CMS. The staff rows land in
# the Hub's team_staff table.
# DATABASE_URL=postgresql://dragons:dragons@localhost:5432/dragons

# `--portraits` pass only: the Hub's asset bucket, i.e. the API's
# GCS_BUCKET_NAME — NOT GCS_MEDIA_BUCKET, which is the CMS media bucket the
# portraits are copied *out of*. Access is Application Default Credentials
# (`gcloud auth application-default login`), so there is no key to set here.
# GCS_BUCKET_NAME=
