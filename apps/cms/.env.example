# Payload CMS (apps/cms) — copy to apps/cms/.env
# These vars are read only by @dragons/cms; the root .env.example stays scoped
# to apps/api (docs-drift.test.ts enforces that).

# Second database on the shared dev postgres container. A fresh pgdata volume
# creates it via docker/postgres-init/; an existing volume needs it once by hand:
#   docker compose -f docker/docker-compose.dev.yml exec postgres createdb -U dragons dragons_cms
DATABASE_URL_CMS=postgresql://dragons:dragons@localhost:5432/dragons_cms

# openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Prod only: GCS bucket for the media collection (provisioned by OpenTofu,
# Task A5). Leave unset in dev — media then lands on local disk (apps/cms/media/).
# GCS_MEDIA_BUCKET=

# Prod only: "true" when the media bucket grants allUsers read (tofu var
# cms_media_public). Media URLs then point straight at storage.googleapis.com;
# anything else keeps them relative and proxied through this service. Must match
# the bucket's actual IAM or every image 403s.
# GCS_MEDIA_PUBLIC=

# Prod only: comma-separated public origins (first = Payload serverURL; all are
# trusted for CORS/CSRF — the load-balancer domains). Set by OpenTofu on the
# Cloud Run service. Leave unset in dev — Payload then uses relative URLs and
# same-origin requests.
# CMS_PUBLIC_URL=

# Prod only: fine-grained PAT (Task D3) for the repository_dispatch that
# rebuilds the public site on publish. Leave unset in dev — every dispatch is
# then a silent no-op. Same-named var on the API is the webhook channel's PAT.
# GH_DISPATCH_TOKEN=
