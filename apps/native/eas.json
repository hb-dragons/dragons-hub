{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.16.0",
      "pnpm": "11.21.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3001"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.app.hbdragons.de",
        "EXPO_PUBLIC_CHATBOT_ENABLED": "true"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.app.hbdragons.de",
        "EXPO_PUBLIC_CHATBOT_ENABLED": "true"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {},
      "android": {}
    },
    "production": {
      "ios": {},
      "android": {}
    }
  }
}
