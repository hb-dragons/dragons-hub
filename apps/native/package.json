{
  "name": "@dragons/native",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "//": "react is pinned to one version workspace-wide (see `overrides` in pnpm-workspace.yaml), which is a patch ahead of the SDK 57 pin. Excluding it here keeps `expo doctor`'s dependency-version check ON for every other package instead of skipping the whole check.",
      "exclude": [
        "react"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "check:doctor": "expo-doctor",
    "//typecheck": "`expo customize tsconfig.json` is the no-dev-server way to regenerate .expo/types/router.d.ts (the CLI names that path itself). Those declarations are what make expo-router's `Href` the union of this app's routes instead of `string`, and they are gitignored, so without this step CI would typecheck every route href against `string` and pass. `lib/nav/href.ts` fails the build if the step silently no-ops.",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.199",
    "@better-auth/expo": "1.6.23",
    "@dragons/api-client": "workspace:*",
    "@dragons/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@sentry/react-native": "~7.11.0",
    "@ungap/structured-clone": "^1.3.0",
    "ai": "^6.0.197",
    "better-auth": "1.6.23",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "57.0.15",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.18",
    "i18n-js": "^4.5.1",
    "react": "19.2.6",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-marked": "^8.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.6",
    "expo-doctor": "1.20.1",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
