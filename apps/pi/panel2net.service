[Unit]
Description=Panel2Net Stramatel ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hb/Panel2Net
ExecStart=/home/hb/Panel2Net/.venv/bin/python3 /home/hb/Panel2Net/Panel2Net.py
Restart=always
RestartSec=10
User=hb

[Install]
WantedBy=multi-user.target
