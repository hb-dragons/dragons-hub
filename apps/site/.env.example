# Build-time secrets (server only, never exposed to the client).
# CMS content reads during `astro build`.
CMS_URL=https://cms.hbdragons.de
CMS_API_TOKEN=changeme

# Client-exposed (PUBLIC_ prefix): base URL for browser islands.
PUBLIC_API_URL=https://api.app.hbdragons.de

# Scoreboard panel id for the live island (must match the API's
# SCOREBOARD_DEVICE_ID). Optional — defaults to the production panel id.
PUBLIC_SCOREBOARD_DEVICE_ID=dragons-1
