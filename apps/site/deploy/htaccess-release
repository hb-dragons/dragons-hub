# Uploaded by deploy-site.yml into every release as releases/<sha>/.htaccess.
# It is the docroot file for site.testing.hbdragons.de; live traffic also
# passes through here via current/, so the noindex header is host-gated.
# Every directive below is module-gated (#260): an unloaded module makes Apache
# return 500 for every request in this directory rather than skip the line,
# and this file is the docroot for the testing host while live apex traffic
# passes through it via current/. A missing module must cost us a header, not
# the site.
<IfModule mod_setenvif.c>
  SetEnvIf Host ^site\.testing\. TESTING_HOST

  # Everything Astro emits under _astro/ carries a content hash in its name —
  # CSS, JS, fonts, the resized images and the hero video. A changed file is a
  # changed URL, so the old one can be cached forever. Nothing else in the
  # release is hashed, which is why this is matched on path and not on
  # extension: /img/logo.svg shares an extension with hashed assets but keeps
  # its name across deploys, and pinning it for a year would strand a stale
  # logo in every visitor's cache.
  SetEnvIf Request_URI "/_astro/" HASHED_ASSET
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=TESTING_HOST

  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

  # Unhashed assets straight out of public/: long enough to help a repeat
  # visit, short enough that replacing one is visible the next day.
  <FilesMatch "\.(?:avif|gif|ico|jpe?g|mp4|png|svg|webm|webp|woff2?|txt|xml)$">
    Header set Cache-Control "public, max-age=86400" env=!HASHED_ASSET
  </FilesMatch>

  # HTML must never be cached. A deploy repoints `current` at a new release
  # under the same URLs, so a cached page would keep pointing at the previous
  # release's hashed assets — which the release pruner deletes after five
  # deploys. `no-cache` still allows a 304, it only forbids reuse without
  # revalidating.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# The host negotiates no compression of its own: HTML and CSS were served
# uncompressed even to clients sending Accept-Encoding: gzip. Nested gating is
# deliberate — AddOutputFilterByType belongs to mod_filter, not mod_deflate.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
      application/javascript application/json application/xml \
      application/rss+xml image/svg+xml
  </IfModule>
</IfModule>

ErrorDocument 404 /404.html
