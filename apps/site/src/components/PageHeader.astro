---
/**
 * Banner-title band above every subpage, ported from dragons-app PageHeader
 * (+ UiBannerImage/UiOverlay). Defaults to the club banner; pages with their
 * own header image pass it in.
 */
import type { SiteImage } from "../lib/media";
import { BANNER_IMAGE } from "../lib/site-assets";
import BlurImage from "./BlurImage.astro";

interface Props {
  title: string;
  image?: SiteImage | null;
}

const { title, image = null } = Astro.props;
const img = image ?? BANNER_IMAGE;
---

<div class="h-[200px] md:h-[400px] relative z-0 overflow-hidden">
  <div class="w-full h-full">
    <div class="absolute top-0 left-0 w-full h-full">
      <BlurImage
        src={img.url}
        blurhash={img.blurhash}
        alt={"alt" in img ? (img.alt ?? "") : ""}
        class="w-full h-full"
        imgClass="object-cover"
        loading="eager"
      />
      <div class="absolute top-0 left-0 w-full h-full dark:bg-black/70 bg-white/70"></div>
    </div>

    <div class="absolute top-0 left-0 w-full h-full flex items-center justify-center">
      <h1 class="text-4xl md:text-7xl font-bold text-foreground text-center">{title}</h1>
    </div>
  </div>
</div>
