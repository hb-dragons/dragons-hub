---
/**
 * Post body renderer: Lexical → HTML at build time (lib/lexical-html.ts),
 * typography via the global .rich-text styles below — the same visual rules
 * the legacy UiRichTextRenderer attached as per-node Tailwind classes.
 * Styles are `is:global` because `set:html` content never receives Astro's
 * scoped-style attributes.
 */
import { lexicalToHtml, type LexicalContent } from "../../lib/lexical-html";
import { cmsBaseUrl } from "../../lib/media";

interface Props {
  content: LexicalContent | null | undefined;
}

const html = lexicalToHtml(Astro.props.content, cmsBaseUrl());
---

{html !== "" && <div class="rich-text max-w-none" set:html={html} />}

<style is:global>
  .rich-text p {
    margin-bottom: 1rem;
    line-height: 1.625;
    font-size: 1rem;
  }
  .rich-text h1,
  .rich-text h2,
  .rich-text h3,
  .rich-text h4,
  .rich-text h5,
  .rich-text h6 {
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1rem;
  }
  .rich-text h1 {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .rich-text h2 {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }
  .rich-text h3 {
    font-size: 1.5rem;
    line-height: 2rem;
  }
  .rich-text h4 {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
  .rich-text h5 {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
  .rich-text h6 {
    font-size: 1rem;
    line-height: 1.5rem;
  }
  .rich-text a {
    color: #51a2ff;
    text-decoration: underline;
    transition: color 150ms;
  }
  .rich-text a:hover {
    color: #8ec5ff;
  }
  .rich-text blockquote {
    border-left: 4px solid var(--border);
    padding: 0.5rem 0 0.5rem 1rem;
    margin-bottom: 1rem;
    font-style: italic;
    color: var(--muted-foreground);
  }
  .rich-text ul,
  .rich-text ol {
    margin-bottom: 1rem;
    padding-left: 0;
    list-style-position: inside;
  }
  .rich-text ul {
    list-style-type: disc;
  }
  .rich-text ol {
    list-style-type: decimal;
  }
  .rich-text li {
    margin-bottom: 0.5rem;
  }
  .rich-text pre {
    background: var(--surface-high);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
    overflow-x: auto;
  }
  .rich-text code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .rich-text figure {
    margin-bottom: 1.5rem;
  }
  .rich-text figure img {
    width: 100%;
    max-height: 700px;
    object-fit: cover;
    border-radius: 0.5rem;
    box-shadow: var(--shadow-md);
  }
  .rich-text figcaption {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    text-align: center;
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .rich-text p {
      font-size: 1.125rem;
      line-height: 1.625;
    }
    .rich-text h1 {
      font-size: 3rem;
      line-height: 1;
    }
    .rich-text h2 {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
    .rich-text h3 {
      font-size: 1.875rem;
      line-height: 2.25rem;
    }
    .rich-text h4 {
      font-size: 1.5rem;
      line-height: 2rem;
    }
    .rich-text h5 {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
    .rich-text h6 {
      font-size: 1.125rem;
      line-height: 1.75rem;
    }
  }
  @media (min-width: 1280px) {
    .rich-text p {
      font-size: 1.25rem;
      line-height: 1.625;
    }
  }
</style>
