---
/**
 * Shop product card, ported from dragons-app ShopProductCard. The Payload
 * shop item carries a single image (the legacy Strapi carousel/lightbox had
 * an images array), so the card renders one static picture — no island.
 */
import type { CollectionEntry } from "astro:content";

import { formatPrice } from "../../lib/format";
import { cmsBaseUrl } from "../../lib/media";
import { toSiteImage } from "../../lib/site-image";
import BlurImage from "../BlurImage.astro";
import { strings } from "../../lib/strings";

interface Props {
  item: CollectionEntry<"shopItems">["data"];
}

const { item } = Astro.props;
const image = toSiteImage(item.image, cmsBaseUrl());
const price = formatPrice(item.price);

/** Nuxt UI soft primary button, block size lg — classes from prod markup. */
const BUY_BUTTON_CLASSES =
  "rounded-md font-medium inline-flex items-center transition-colors px-3 py-2 text-sm gap-2 w-full justify-center text-primary bg-primary/10 hover:bg-primary/15";
---

<div class="rounded-lg bg-card border border-border overflow-hidden">
  <div class="relative aspect-square overflow-hidden mb-4">
    {
      image ? (
        <BlurImage
          src={image.url}
          blurhash={image.blurhash}
          alt={image.alt ?? item.name}
          class="w-full h-full"
          imgClass="object-cover"
        />
      ) : (
        <div class="w-full h-full bg-muted flex items-center justify-center" aria-label={strings.shop.noImage}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-12 h-12 text-muted-foreground"
            aria-hidden="true"
            ><line x1="2" x2="22" y1="2" y2="22"></line><path
              d="M10.41 10.41a2 2 0 1 1-2.83-2.83"></path><line x1="13.5" x2="6" y1="13.5" y2="21"
            ></line><line x1="18" x2="21" y1="12" y2="15"></line><path
              d="M3.59 3.59A1.99 1.99 0 0 0 3 5v14a2 2 0 0 0 2 2h14c.55 0 1.052-.22 1.41-.59"
            ></path><path d="M21 15V5a2 2 0 0 0-2-2H9"></path></svg
          >
        </div>
      )
    }
  </div>

  <div class="space-y-3 p-2 md:p-3 lg:p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-lg font-semibold text-foreground line-clamp-2">{item.name}</h3>
      {
        price && (
          <span class="text-lg font-bold text-primary whitespace-nowrap font-mono">{price}</span>
        )
      }
    </div>

    {
      item.description && (
        <p class="text-sm text-muted-foreground whitespace-pre-line">{item.description}</p>
      )
    }

    {
      item.link && (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class={BUY_BUTTON_CLASSES}
          aria-label={`${item.name} ${strings.shop.buyAriaSuffix}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5"
            aria-hidden="true"
          >
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
            <path d="M3 6h18" />
            <path d="M16 10a4 4 0 0 1-8 0" />
          </svg>
          {strings.shop.buy}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      )
    }
  </div>
</div>
