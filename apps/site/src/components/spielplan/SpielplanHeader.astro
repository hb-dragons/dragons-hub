---
/**
 * Local replica of dragons-app `app/components/PageHeader.vue` (banner band,
 * black overlay, centered title) for the Spielplan page only. Issue #173
 * introduces the shared `components/PageHeader.astro`; swap this for it once
 * that lands — tracked in the PR body. Plain <img> instead of the legacy
 * blurhash placeholder; the site is dark-only, so the light overlay variant
 * is dropped.
 */
import { strings } from "../../lib/strings";
---

<div class="h-[200px] md:h-[400px] relative z-0 overflow-hidden">
  <div class="w-full h-full">
    <div class="absolute top-0 left-0 w-full h-full">
      <img src="/img/banner.webp" alt="" class="w-full h-full object-cover" />
      <div class="absolute top-0 left-0 w-full h-full bg-black/70"></div>
    </div>

    <div class="absolute top-0 left-0 w-full h-full flex items-center justify-center">
      <h1 class="text-4xl md:text-7xl font-bold text-foreground text-center">
        {strings.spielplan.heading}
      </h1>
    </div>
  </div>
</div>
