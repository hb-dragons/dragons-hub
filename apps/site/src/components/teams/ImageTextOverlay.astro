---
/**
 * Bottom text gradient over a hero image, ported from dragons-app
 * UiImageTextOverlay (title + optional subtitle; the email variant has no
 * consumer on the teams pages and stays unported).
 */
interface Props {
  title?: string | undefined;
  subTitle?: string | undefined;
}

const { title, subTitle } = Astro.props;
const hasSubTitleSlot = Astro.slots.has("subTitle");
---

<div
  class="absolute inset-x-0 bottom-0 z-10 px-3 pb-3 pt-6 md:px-6 md:pb-4 md:pt-8 bg-gradient-to-t from-black/80 via-black/20 to-transparent @container"
>
  {
    title && (
      <h3 class="text-xl @md:text-2xl @lg:text-3xl font-bold mb-0 @md:mb-2 drop-shadow-lg text-white">
        {title}
      </h3>
    )
  }
  {
    (subTitle || hasSubTitleSlot) && (
      <h3 class="text-base md:text-xl drop-shadow-lg text-neutral-100">
        {hasSubTitleSlot ? <slot name="subTitle" /> : subTitle}
      </h3>
    )
  }
</div>
