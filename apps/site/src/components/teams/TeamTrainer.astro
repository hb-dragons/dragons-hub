---
/**
 * Team + trainer hero on the detail page, ported from dragons-app
 * TeamsTeamTrainer (components/teams/TeamTrainer.vue): the wide team photo
 * with the "Team"/league overlay, the trainer portrait with the name/"Coach"
 * overlay, both angled by clip-path on md+.
 *
 * The legacy league link (`basketball-bund.net/static/#/liga/<ligaId>`) is
 * plain text here: the public API does not expose the federation liga id
 * (only internal league ids), so there is nothing correct to link to.
 */
import type { SiteImage } from "../../lib/media";
import { BANNER_IMAGE } from "../../lib/site-assets";
import { strings } from "../../lib/strings";
import BlurImage from "../BlurImage.astro";
import ImageTextOverlay from "../ImageTextOverlay.astro";

interface Props {
  teamImage: SiteImage | null;
  leagueName: string | null;
  trainer: { name: string; image: SiteImage | null } | null;
}

const { teamImage, leagueName, trainer } = Astro.props;
const team = teamImage ?? BANNER_IMAGE;
const portrait = trainer?.image ?? BANNER_IMAGE;
---

<div
  class="flex flex-col gap-4 md:gap-0 justify-center items-center md:items-stretch md:rounded-lg md:overflow-hidden md:flex-row w-full md:h-[500px] lg:h-[600px] xl:h-[700px]"
>
  <div
    class="w-full relative h-[250px] md:h-auto rounded-md border md:rounded-none md:border-none overflow-hidden md:w-5/6 md:[clip-path:polygon(0%_0%,100%_0%,90%_100%,0%_100%)]"
  >
    <BlurImage
      src={team.url}
      blurhash={team.blurhash}
      alt={"alt" in team ? (team.alt ?? "") : ""}
      class="w-full h-full select-none pointer-events-none"
      imgClass="object-cover"
    />
    <ImageTextOverlay title={strings.teams.overlayTeam}>
      {leagueName && <span slot="subTitle">{leagueName}</span>}
    </ImageTextOverlay>
  </div>
  <div
    class="w-full relative h-[300px] md:h-auto md:w-2/6 rounded-md border md:rounded-none md:border-none overflow-hidden md:[clip-path:polygon(25%_0%,100%_0%,100%_100%,0%_100%)] ml-0 md:-ml-12 lg:-ml-16 xl:-ml-20 2xl:-ml-24"
  >
    <BlurImage
      src={portrait.url}
      blurhash={portrait.blurhash}
      alt={"alt" in portrait ? (portrait.alt ?? "") : ""}
      class="h-full w-full select-none pointer-events-none"
      imgClass="object-cover md:object-bottom"
    />
    {
      trainer ? (
        <ImageTextOverlay title={trainer.name} subTitle={strings.teams.coach} />
      ) : (
        <ImageTextOverlay title={strings.teams.trainerFallback} />
      )
    }
  </div>
</div>
