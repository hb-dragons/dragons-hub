---
import { Font } from "astro:assets";
import "../styles/global.css";

import NavBar from "../components/NavBar.astro";
import PageFooter from "../components/PageFooter.astro";
import ProbetrainingButton from "../components/ProbetrainingButton.astro";
import Seo from "../components/Seo.astro";
import SiteBackground from "../components/SiteBackground.astro";
import type { JsonLd } from "../lib/jsonld";
import { strings } from "../lib/strings";

interface Props {
  /** Page part of the title (Seo.astro appends the club suffix). */
  title: string;
  /** Meta description; pages not yet migrated fall back to the site-wide one. */
  description?: string | undefined;
  /** OG/Twitter image URL or public/ path (see Seo.astro). */
  image?: string | null | undefined;
  jsonLd?: JsonLd | JsonLd[] | undefined;
  noindex?: boolean | undefined;
  ogType?: "website" | "article" | undefined;
}
const {
  title,
  description = strings.seo.defaultDescription,
  image = null,
  jsonLd,
  noindex = false,
  ogType = "website",
} = Astro.props;
---

<html lang="de" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The page forces `class="dark"` below, so the browser has to be told
         too, or scrollbars, autofill and form popups render in light chrome
         against a dark page (#262). -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#18181b" />
    <!-- Square crops of public/img/logo.svg, which is 3:4 and would be
         letterboxed by the browser. SVG first for the tab, PNG for the
         browsers that still refuse SVG icons, and the 180px apple-touch-icon
         for an iOS home-screen bookmark.

         The tab icons are transparent — a browser draws them against its own
         chrome, which is not this page's #18181b in either theme. The
         apple-touch-icon is the exception and stays opaque: iOS composites a
         home-screen icon onto black, so transparency there is a black tile,
         not a transparent one. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <Seo {title} {description} {image} {jsonLd} {noindex} {ogType} />
    <!-- BlurImage holds each image at opacity 0 until its `onload` fires, so
         with scripting off it would never appear. This is the only place that
         can say so: `<noscript>` in `<head>` may contain a `<style>`. -->
    <noscript><style>img[data-blur-img] { opacity: 1 !important; }</style></noscript>
    {/* Preload only the weights on screen before any scroll: 400 (body), 700
        (headings/font-bold) and 800 (the nav's font-black). 500/600 still
        load via their @font-face rules when first used — preloading all five
        was queueing two unused files against the LCP image. */}
    <Font
      cssVariable="--font-bricolage"
      preload={[{ weight: "400" }, { weight: "700" }, { weight: "800" }]}
    />
    <Font cssVariable="--font-jetbrains-mono" />
    <slot name="head" />
  </head>
  <body>
    {/* First tab stop: keyboard and screen-reader users skip the nav (with
        its team mega-panel) instead of walking it on every page. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-foreground"
    >
      {strings.site.skipToContent}
    </a>
    <NavBar />
    <main id="main" class="min-h-screen relative">
      <SiteBackground />
      <ProbetrainingButton />
      <slot />
    </main>
    <PageFooter />
  </body>
</html>
