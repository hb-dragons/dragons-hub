---
// Port of dragons-app app/pages/dragons/philosophie/index.vue. The legacy
// page was a hardcoded "Coming soon"; here the CMS page (slug=philosophie)
// may carry layout blocks — until it does, the ComingSoon section keeps
// prod parity.
import { getCollection } from "astro:content";

import ComingSoon from "../../../components/ComingSoon.astro";
import PageBlocks from "../../../components/page-blocks/PageBlocks.astro";
import PageContainer from "../../../components/PageContainer.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Layout from "../../../layouts/Layout.astro";
import { cmsBaseUrl } from "../../../lib/media";
import { toSiteImage } from "../../../lib/site-image";
import { strings } from "../../../lib/strings";

const pageEntries = await getCollection(
  "pages",
  ({ data }) => data._status === "published" && data.slug === "philosophie",
);
const page = pageEntries[0]?.data ?? null;
const blocks = page?.layout ?? [];
---

<Layout title={strings.dragons.philosophie.pageTitle}>
  <PageHeader
    title={page?.header?.title ?? strings.dragons.philosophie.heading}
    image={toSiteImage(page?.header?.image, cmsBaseUrl())}
  />

  {
    blocks.length > 0 ? (
      <PageContainer>
        <PageBlocks layout={blocks} />
      </PageContainer>
    ) : (
      <ComingSoon />
    )
  }
</Layout>
