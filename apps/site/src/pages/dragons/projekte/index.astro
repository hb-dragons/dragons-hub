---
// Port of dragons-app app/pages/dragons/projekte/index.vue + ProjectRows:
// CMS page header (slug=projekte) over the shared ItemRows band and project
// list; any layout blocks render below.
import { getCollection } from "astro:content";

import ItemRows, { type RowItem } from "../../../components/ItemRows.astro";
import PageBlocks from "../../../components/page-blocks/PageBlocks.astro";
import PageContainer from "../../../components/PageContainer.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Layout from "../../../layouts/Layout.astro";
import { cmsBaseUrl } from "../../../lib/media";
import { toSiteImage } from "../../../lib/site-image";
import { strings } from "../../../lib/strings";

const cmsBase = cmsBaseUrl();

const pageEntries = await getCollection(
  "pages",
  ({ data }) => data._status === "published" && data.slug === "projekte",
);
const page = pageEntries[0]?.data ?? null;

const projects: RowItem[] = (await getCollection("projects")).map(({ data }) => ({
  name: data.title,
  description: data.description,
  logo: toSiteImage(data.image, cmsBase),
  link: data.link,
}));
---

<Layout title={strings.dragons.projekte.pageTitle}>
  <PageHeader
    title={page?.header?.title ?? strings.dragons.projekte.heading}
    image={toSiteImage(page?.header?.image, cmsBase)}
  />

  <PageContainer>
    <ItemRows
      items={projects}
      heroTitle={strings.dragons.projekte.heroTitle}
      heroDescription={strings.dragons.projekte.heroDescription}
      listTitle={strings.dragons.projekte.listTitle}
      buttonLabel={strings.dragons.projekte.buttonLabel}
    />
    <PageBlocks layout={page?.layout} />
  </PageContainer>
</Layout>
