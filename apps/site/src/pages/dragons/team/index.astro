---
// Port of dragons-app app/pages/dragons/team/index.vue. Vorstand +
// Ehrenamtliche render both from the CMS page's contact block (slug=team →
// PageBlocks, when a layout asks for it) and directly here, so the sections
// show even though every Strapi-migrated dynamic zone is empty. Refs renders
// the referees collection directly, like the legacy page. Fully static — no
// islands.
//
// The Coaches band reads the Hub's team staff (ADR 0008, issue #314) rather
// than the CMS trainers collection, gated on a content build the way the other
// build-time API fetches are (src/pages/spielplan/index.astro).
import { getCollection } from "astro:content";

import PersonCard from "../../../components/kontakt/PersonCard.astro";
import PositionsGrid from "../../../components/kontakt/PositionsGrid.astro";
import RefereesGrid from "../../../components/kontakt/RefereesGrid.astro";
import VorstandGrid from "../../../components/kontakt/VorstandGrid.astro";
import PageBlocks from "../../../components/page-blocks/PageBlocks.astro";
import PageContainer from "../../../components/PageContainer.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Layout from "../../../layouts/Layout.astro";
import { apiBase } from "../../../lib/api-base";
import { cmsBaseUrl } from "../../../lib/media";
import { publishedPage } from "../../../lib/pages";
import { publishedOnly } from "../../../lib/published";
import { pageSeo } from "../../../lib/seo";
import { toSiteImage } from "../../../lib/site-image";
import { strings } from "../../../lib/strings";
import { clubCoaches, fetchTeamStaff } from "../../../lib/team-staff";

const cmsBase = cmsBaseUrl();

// "kontakt" is the legacy Strapi slug — accepted until A6 pins the mapping,
// so the contact block never silently vanishes on a slug mismatch.
const page = publishedPage(await getCollection("pages"), "team", "kontakt");

const coaches = cmsBase !== undefined ? clubCoaches(await fetchTeamStaff(apiBase())) : [];
const vorstand = (await getCollection("vorstand", publishedOnly))
  .map((entry) => entry.data)
  .sort((a, b) => a.orderIndex - b.orderIndex);
const positions = (await getCollection("positions", publishedOnly))
  .map((entry) => entry.data)
  .sort((a, b) => a.orderIndex - b.orderIndex);
const referees = (await getCollection("referees", publishedOnly)).map((entry) => entry.data);

const headerTitle = page?.header?.title ?? strings.dragons.team.heading;
const seo = pageSeo(page, cmsBase, strings.seo.kontakt);
---

<Layout title={headerTitle} description={seo.description} image={seo.image}>
  <PageHeader title={headerTitle} image={toSiteImage(page?.header?.image, cmsBase)} />

  <PageContainer>
    <PageBlocks layout={page?.layout} />

    <VorstandGrid entries={vorstand} />
    <PositionsGrid entries={positions} />

    {
      coaches.length > 0 && (
        <div>
          <h2 class="text-3xl font-bold text-foreground mt-8 mb-8 text-center">
            {strings.dragons.team.coachesHeading}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4 md:gap-4 md:-space-x-12">
            {coaches.map((coach) => (
              <div class="w-full overflow-hidden rounded-md">
                <PersonCard
                  name={coach.name}
                  image={coach.photoUrl === null ? null : { url: coach.photoUrl, alt: coach.name }}
                  clipDirection="none"
                  showEmail={false}
                >
                  {
                    coach.licence && (
                      <span
                        slot="subTitle"
                        class="inline-flex items-center px-2.5 py-1.5 gap-1.5 rounded-md text-foreground bg-card text-base font-semibold uppercase"
                      >
                        {coach.licence}
                      </span>
                    )
                  }
                </PersonCard>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <RefereesGrid entries={referees} />
  </PageContainer>
</Layout>
