---
// Home, ported 1:1 from dragons-app index.vue: Start (hero) → Join → NextGames
// → News → FollowUs. Hero comes from HomeStart.vue + HomeVideoBackground.vue —
// the motion-v letter stagger is server-rendered spans + CSS delays (zero JS).
import { Font } from "astro:assets";

import heroPoster from "../assets/img/hero-poster.webp";
import heroVideo from "../assets/video.webm";
import Layout from "../layouts/Layout.astro";
import ScoreboardIsland from "../components/live/ScoreboardIsland";
import NextGamesIsland from "../components/NextGamesIsland";
import HomeFollowUs from "../components/home/FollowUs.astro";
import HomeJoin from "../components/home/Join.astro";
import HomeNews from "../components/home/News.astro";
import { apiBase } from "../lib/api-base";
import { fetchHomeDashboard, yearsSinceFounding } from "../lib/home-stats";
import { sportsOrganization } from "../lib/jsonld";
import { nextGames } from "../lib/next-games";
import { getSiteSettings } from "../lib/payload";
import { absoluteUrl } from "../lib/seo";
import { strings } from "../lib/strings";

const firstPart = strings.site.claim.courtPart;
const secondPart = strings.site.claim.culturesPart;

// SEO (Task C8): the claim as the unique home title part, the club as
// schema.org SportsOrganization.
const jsonLd = sportsOrganization({
  url: absoluteUrl("/", Astro.site),
  logo: absoluteUrl("/img/logo.svg", Astro.site),
});

// Club stats: memberCount/foundingYear from the site-settings global, live
// teamCount plus the NextGames first paint from the API dashboard. On content
// builds every input is required and any failure throws — the loaders' failure
// model (a broken CMS/API must never silently drop the band prod always
// shows); env-less shell builds skip the fetch, hide the row, and leave the
// island to its client-side fetch.
const settings = await getSiteSettings();
if (settings !== null && (settings.memberCount == null || settings.foundingYear == null)) {
  throw new Error(
    "site-settings: memberCount and foundingYear must both be set — the home stats band renders them",
  );
}
const dashboard = settings === null ? null : await fetchHomeDashboard(apiBase());
const teamCount = dashboard?.teamCount ?? null;
// Windowed at build time with the build's clock; the island re-windows on the
// client, so a stale window only ever survives until hydration.
const initialGames = dashboard === null ? null : nextGames(dashboard.upcomingGames);
const memberCount = settings?.memberCount ?? null;
const years =
  settings?.foundingYear != null ? yearsSinceFounding(settings.foundingYear, new Date()) : null;
---

<Layout
  title={`${firstPart}${secondPart}`}
  description={strings.seo.defaultDescription}
  jsonLd={jsonLd}
>
  {/* Edo is loaded here rather than in Layout: the claim below is the only
      place on the site that uses it, so no other page carries the request. */}
  <Fragment slot="head">
    <Font cssVariable="--font-edo" preload />
    {/* The poster is the hero's first paint (the video streams in behind it),
        so pull it ahead of the font/CSS queue instead of letting the browser
        find it at video-attribute priority. */}
    <link rel="preload" as="image" href={heroPoster.src} fetchpriority="high" />
  </Fragment>

  <div class="relative">
    <div class="w-full h-svh">
      {/* Decorative, and behind an 80% black scrim — it was shipping at
          2.2 Mbps (5.3 MB) for footage that is soft and grainy to begin with,
          so most of that bitrate was encoding noise nobody can see through the
          overlay. Re-encoded two-pass at 350 kbps with a denoise pass: 850 kB.
          Imported rather than served from public/ so it gets a content-hashed
          filename, which is what lets deploy/htaccess-release cache it
          immutably. The poster is frame 0, so the handover to the first video
          frame is invisible, and it is also what browsers without WebM
          playback are left with.

          preload="metadata", not "auto": autoplay makes the browser fetch the
          stream when playback starts anyway, but at media priority after the
          document settles — "auto" was queueing the full 850 kB against the
          fonts and the poster during first paint. */}
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroPoster.src}
        aria-hidden="true"
        class="w-full h-full object-cover"
      >
        <source src={heroVideo} type="video/webm" />
      </video>
      <div class="absolute inset-0 bg-black/80"></div>
      <div class="absolute inset-0 flex justify-center items-center">
        <div class="relative h-full w-full flex justify-center items-center z-10">
          {/* Stacked (below lg) the column centers as one group and the crest
              sizes itself — the legacy h-3/7 box with a bottom-pinned logo is
              a row construct: stacked, it padded the crest with invisible
              space and left the bottom 40% of the viewport empty. */}
          <div class="flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16 h-full">
            <div class="lg:h-3/7 flex justify-center lg:items-center items-end">
              {/* w-auto is load-bearing next to the width/height attributes:
                  CSS sets only the height, so without it the width attribute
                  acts as the used width and renders the logo 1422px wide.
                  With it the attributes contribute only the aspect ratio. */}
              <img
                src="/img/logo.svg"
                alt={strings.site.logoAlt}
                width="1422"
                height="1894"
                class="w-auto h-[24svh] lg:h-3/5 hero-logo"
              />
            </div>
            <div class="text-center lg:text-left">
              <h1 class="text-4xl md:text-6xl xl:text-7xl font-bold text-white hero-title">
                {strings.site.name}
              </h1>
              {/* Below md the size is fluid: the claim is one unbreakable line
                  of 12.39em (see the style block), so the fixed 1.74rem step
                  clips on viewports under ~357px. min() keeps 1.74rem for
                  every common phone and lets 7.6vw take over below that —
                  12.39em at 7.6vw is ~94% of the viewport. */}
              <div class="hero-claim rounded-md text-[min(1.74rem,7.6vw)] md:text-[3.42rem] lg:text-[3.44rem] xl:text-[4.09rem] text-white mt-2">
                {
                  [...firstPart].map((char, i) => (
                    <span
                      class="inline-block text-primary hero-letter"
                      style={`animation-delay: ${0.5 + i * 0.01}s`}
                    >
                      {char === " " ? "\u00A0" : char}
                    </span>
                  ))
                }
                {
                  [...secondPart].map((char, i) => (
                    <span
                      class="inline-block text-heat hero-letter"
                      style={`animation-delay: ${0.5 + (firstPart.length + i) * 0.01}s`}
                    >
                      {char === " " ? "\u00A0" : char}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 hero-scroll">
          <div class="flex flex-col items-center space-y-2">
            <span class="text-white/60 text-sm font-medium">{strings.home.scrollHint}</span>
            <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center">
              <div class="w-1 h-3 bg-white/60 rounded-full mt-2 hero-scroll-dot"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <HomeJoin {memberCount} {teamCount} {years} />

  {/* Live board: renders nothing unless a broadcast is on, so it adds no
      layout when hidden. client:idle, not client:visible — the island mounts
      empty (zero-size), so a viewport trigger might never fire, and it must
      connect early to know whether there is anything to show at all. */}
  <ScoreboardIsland client:idle />

  {/* client:visible, not client:load: the band sits below the 100svh hero and
      already server-renders initialGames (shell builds render a sized
      skeleton, so the viewport trigger always has geometry to fire on).
      Hydration only revalidates, and eager hydration was the single biggest
      main-thread cost on mobile — the React runtime has no other client:load
      user, so this keeps it off the critical path entirely. */}
  <NextGamesIsland client:visible initialGames={initialGames} />

  <HomeNews />

  <HomeFollowUs />
</Layout>

<style>
  .hero-logo {
    animation: logo-in 0.5s ease-out both;
  }
  .hero-title {
    animation: fade-up 0.5s ease-out both;
  }
  /* The claim is the one piece of Edo SZ on the site. Its brush strokes carry
     a smaller apparent size than Bricolage at the same em, hence the larger
     steps above.

     The claim is one line of per-character spans, so it must not wrap — a
     break would land mid-word. Every step is sized against the font's own
     advance widths so the line fills the space its breakpoint gives it. This
     string is 12.39em in Edo SZ, against 14.89em in the Edo it replaced, so
     each step grew by that ratio (1.202x) to hold the rendered width still.
     Re-measure if the claim text or the font changes — and measure the
     advances, since the markup emits nbsp for the spaces and nbsp is outside
     the font's declared range. */
  .hero-claim {
    font-family: var(--font-edo);
    font-weight: 400;
  }
  .hero-letter {
    opacity: 0;
    animation: letter-in 0.3s ease-out both;
    /* per-letter delay set inline */
  }
  .hero-scroll {
    animation: fade-in 0.5s ease-out 2s both;
  }
  /* Legacy hides the scroll hint once scrolled (AnimatePresence exit). */
  :global(html[data-scrolled]) .hero-scroll {
    animation: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .hero-scroll-dot {
    animation: scroll-bounce 2s ease-in-out infinite;
  }
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
</style>
