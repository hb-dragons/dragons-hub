---
// Port of dragons-app app/pages/probetraining/index.vue: CMS page header
// (slug=probetraining) over the two-step request form island. The legacy page
// fetched the slug "news" page for its header image — an evident copy-paste
// slip this port does not repeat.
import { getCollection } from "astro:content";

import PageContainer from "../../components/PageContainer.astro";
import PageHeader from "../../components/PageHeader.astro";
import FormIsland from "../../components/probetraining/FormIsland";
import Layout from "../../layouts/Layout.astro";
import { cmsBaseUrl } from "../../lib/media";
import { publishedPage } from "../../lib/pages";
import { pageSeo } from "../../lib/seo";
import { toSiteImage } from "../../lib/site-image";
import { strings } from "../../lib/strings";

const cmsBase = cmsBaseUrl();

const page = publishedPage(await getCollection("pages"), "probetraining");

const headerTitle = page?.header?.title ?? strings.probetraining.fallbackHeading;
const seo = pageSeo(page, cmsBase, strings.seo.probetraining);
---

<Layout title={headerTitle} description={seo.description} image={seo.image}>
  <PageHeader title={headerTitle} image={toSiteImage(page?.header?.image, cmsBase)} />

  <PageContainer>
    <FormIsland client:visible />
  </PageContainer>
</Layout>
