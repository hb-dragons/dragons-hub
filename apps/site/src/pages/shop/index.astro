---
// Port of dragons-app app/pages/shop/index.vue: banner header + product grid
// from the shop-items collection. Fully static — no islands.
import { getCollection } from "astro:content";

import PageContainer from "../../components/PageContainer.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProductCard from "../../components/shop/ProductCard.astro";
import Layout from "../../layouts/Layout.astro";
import { strings } from "../../lib/strings";

const items = (await getCollection("shopItems")).map((entry) => entry.data);
---

<Layout title={strings.shop.heading} description={strings.seo.shop}>
  <PageHeader title={strings.shop.heading} />

  <PageContainer class="h-full flex flex-col lg:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => <ProductCard item={item} />)}
    </div>

    {
      items.length === 0 && (
        <div class="text-center py-12">
          <div class="text-6xl mb-4">🛒</div>
          <h3 class="text-xl font-semibold text-foreground mb-2">{strings.shop.emptyTitle}</h3>
          <p class="text-muted-foreground">{strings.shop.emptyText}</p>
        </div>
      )
    }
  </PageContainer>
</Layout>
