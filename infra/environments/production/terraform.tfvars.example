# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control

project_id     = "your-gcp-project-id"
project_number = "123456789012"
region         = "europe-west3"

# GitHub (for Workload Identity CI/CD)
github_org  = "your-github-org"
github_repo = "dragons-hub"

# Custom Domains
web_domain = "app.dragons.example.com"
api_domain = "api.dragons.example.com"

# CMS domains routed via the load balancer (list — Phase E appends the prod
# domain at cutover; until then it stays off this list because it still points
# at the legacy Strapi host). Empty list = no cms cert/host-rule, run.app URL
# only. In CI: vars.CMS_DOMAINS.
cms_domains = ["cms.testing.dragons.example.com"]

# Basketball-Bund SDK credentials
sdk_username = "your-sdk-username"
sdk_password = "your-sdk-password"

# Referee assignment SDK credentials (separate federation account)
referee_sdk_username = "your-referee-sdk-username"
referee_sdk_password = "your-referee-sdk-password"

# Stramatel scoreboard panel id. Must match the GitHub repo variable
# SCOREBOARD_DEVICE_ID (used as Docker build-arg for the web image) so the
# admin/overlay UI talks to the same device the API ingest is bound to.
scoreboard_device_id = "dragons-1"

# AI features (chatbot + rescheduling assistant + MCP)
# In CI these come from GitHub: vars.CHATBOT_ENABLED / vars.ASSISTANT_ENABLED
# (feature flags) and secrets.GOOGLE_GENERATIVE_AI_API_KEY / secrets.MCP_TOKEN,
# passed as TF_VAR_* by .github/workflows/opentofu.yml.
chatbot_enabled   = "false"
assistant_enabled = "false"

# Google AI Studio key — required (no default). Must be a real key when either
# feature flag is "true", or the API/Worker reject startup. Stored in Secret Manager.
google_generative_ai_api_key = "your-google-ai-studio-key"

# Bearer token for the /mcp endpoint — required (no default), min 32 chars.
mcp_token = "your-mcp-token-at-least-32-characters-long"

# WhatsApp group notifications (WAHA). Not credentials — the adapter sends no
# auth header — so these ride in Cloud Run env_vars on the API and the Worker.
# Leave waha_base_url empty to keep WhatsApp delivery disabled; every send then
# logs "WAHA_BASE_URL not configured, skipping".
# In CI: vars.WAHA_BASE_URL / vars.WAHA_SESSION.
waha_base_url = "https://waha.dragons.example.com"
waha_session  = "default"

# Email notifications (SMTP). Host/port/user/from are relay coordinates, not
# credentials, so they ride in Cloud Run env_vars on the API and the Worker;
# only smtp_password goes to Secret Manager. Leave smtp_host empty to keep
# email delivery disabled — every SMTP_* key and the password secret are then
# omitted, and the provider endpoint stops offering the channel.
# In CI: vars.SMTP_HOST / vars.SMTP_PORT / vars.SMTP_USER / vars.SMTP_FROM and
# secrets.SMTP_PASSWORD.
smtp_host     = ""
smtp_port     = 587
smtp_user     = "noreply@dragons.example.com"
smtp_from     = "Dragons <noreply@dragons.example.com>"
smtp_password = ""

# Expo Push access token — optional. Upgrades push to the authenticated send
# tier (higher rate limits, better receipt SLA). Credential, so it is stored in
# Secret Manager and mounted on the API and the Worker. Leave empty to stay on
# the unauthenticated tier; the secret is then not created at all.
# In CI: secrets.EXPO_ACCESS_TOKEN.
expo_access_token = ""
