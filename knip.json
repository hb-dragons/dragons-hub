{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.base.mjs",
        "scripts/extract-test-seed.ts"
      ],
      "project": [
        "scripts/**/*.{js,mjs,ts}"
      ],
      "ignoreDependencies": [
        "dotenv",
        "pg"
      ]
    },
    "apps/api": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "pino-pretty"
      ]
    },
    "apps/cms": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/site": {
      "project": [
        "src/**/*.{ts,tsx,astro}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "apps/web": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@tailwindcss/postcss"
      ]
    },
    "packages/ui": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/db": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/sdk": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/shared": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/contracts": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/api-client": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/native": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "expo-system-ui",
        "@sentry/cli"
      ]
    }
  },
  "ignoreBinaries": [
    "drizzle-kit"
  ],
  "tags": [
    "-public"
  ]
}
